# Set this to the repository you publish this mirror to.
_repo_url='https://github.com/CHANGE-ME/eden-nx2-lichii'

pkgname=eden-nx2-git
pkgver=0.r0.g0000000
pkgrel=1
pkgdesc='Nintendo Switch emulator (development branch)'
arch=('x86_64')
url="$_repo_url"
license=('GPL-3.0-or-later')
depends=(
  'enet'
  'ffmpeg'
  'libusb'
  'opus'
  'openssl'
  'qt6-base'
  'qt6-charts'
  'sdl3'
  'vulkan-icd-loader'
)
makedepends=(
  'boost'
  'cmake'
  'git'
  'glslang'
  'libzip'
  'lz4'
  'ninja'
  'nlohmann-json'
  'opus'
  'qt6-base'
  'qt6-charts'
  'spirv-headers'
  'spirv-tools'
  'vulkan-headers'
  'vulkan-utility-libraries'
  'xbyak'
  'zlib'
  'zstd'
)
optdepends=(
  'qt6-wayland: native Wayland support'
)
provides=('eden')
conflicts=('eden')
source=("eden::git+$_repo_url.git#branch=main")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/eden"
  printf '0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  cmake -S "$srcdir/eden" -B "$srcdir/build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DENABLE_QT=ON \
    -DENABLE_UPDATE_CHECKER=OFF \
    -DYUZU_CMD=ON \
    -DYUZU_ROOM=OFF \
    -DYUZU_USE_BUNDLED_QT=OFF \
    -DYUZU_USE_BUNDLED_SDL3=OFF \
    -DYUZU_USE_BUNDLED_FFMPEG=OFF \
    -DYUZU_TESTS=OFF \
    -DBUILD_TESTING=OFF
  cmake --build "$srcdir/build" --parallel
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/build"

}
