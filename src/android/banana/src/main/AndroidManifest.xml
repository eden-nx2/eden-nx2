<?xml version="1.0" encoding="utf-8"?>
<!-- Banana Native's components inside Hokkaido: upstream/main/AndroidManifest.xml with upstream/ondevice's
     packer service, without its Application class (Hokkaido's runs HokkaidoBridge.install), its launcher
     entry, its frontend aliases (Hokkaido starts FrontendLaunch itself) and the updater's install permission.
     Keep it in step with upstream's manifests when syncing (tools/android/sync_bananative.sh). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- android.hardware.vulkan.version (not required) is Hokkaido's declaration. -->

    <application>
        <activity
            android:name="dev.nxnative.android.MainActivity"
            android:theme="@style/Theme.Banana"
            android:launchMode="singleTask"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
        <activity
            android:name="dev.nxnative.android.FrontendLaunch"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity
            android:name="dev.nxnative.android.GameActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":game"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density" />
        <activity
            android:name="dev.nxnative.android.SelftestActivity"
            android:exported="false"
            android:process=":selftest"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density" />
        <activity
            android:name="dev.nxnative.android.ReadinessActivity"
            android:exported="false"
            android:process=":readiness"
            android:theme="@style/Theme.Banana"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />
        <provider
            android:name="dev.nxnative.android.LogProvider"
            android:authorities="${applicationId}.logs"
            android:exported="false"
            android:grantUriPermissions="true" />
        <service
            android:name="dev.nxnative.android.PackService"
            android:exported="false"
            android:process=":pack"
            android:foregroundServiceType="dataSync" />
        <!-- Builds the shaders a running game asked for and its library lacks, in the Prepare job's process -->
        <service
            android:name="dev.nxnative.android.LayerService"
            android:exported="false"
            android:process=":pack"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
